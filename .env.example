# Use separate Supabase projects for DEMO and LIVE deployments.
# Never point a LIVE deployment at the DEMO project.
LH_ENVIRONMENT=DEMO
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Do not expose to the browser. Required only for controlled admin/jobs.
SUPABASE_SERVICE_ROLE_KEY=
